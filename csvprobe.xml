<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_CSVPROBE</name>
    <version>1.1.1</version>
    <license>GNU General Public License version 2 or later</license>
    <description>PLG_SYSTEM_CSVPROBE_DESCRIPTION</description>

    <namespace path="src">Ceebl\Plugin\System\Csvprobe</namespace>

    <files>
        <folder plugin="csvprobe">services</folder>
        <folder>src</folder>
        <folder>language</folder>
    </files>

    <config>
        <fields name="params">
            <fieldset name="basic" label="PLG_SYSTEM_CSVPROBE_SETTINGS_LABEL">

                <field
                    name="enable_encoding_fix"
                    type="radio"
                    label="PLG_SYSTEM_CSVPROBE_ENABLE_ENCODING_FIX_LABEL"
                    description="PLG_SYSTEM_CSVPROBE_ENABLE_ENCODING_FIX_DESC"
                    default="1"
                    class="btn-group">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="restrict_downloads"
                    type="radio"
                    label="PLG_SYSTEM_CSVPROBE_RESTRICT_DOWNLOADS_LABEL"
                    description="PLG_SYSTEM_CSVPROBE_RESTRICT_DOWNLOADS_DESC"
                    default="0"
                    class="btn-group">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

                <field
                    name="allowed_groups"
                    type="usergrouplist"
                    label="PLG_SYSTEM_CSVPROBE_ALLOWED_GROUPS_LABEL"
                    description="PLG_SYSTEM_CSVPROBE_ALLOWED_GROUPS_DESC"
                    multiple="true"
                    default=""
                    showon="restrict_downloads:1"
                />

                <field
                    name="hide_export_buttons"
                    type="radio"
                    label="PLG_SYSTEM_CSVPROBE_HIDE_EXPORT_BUTTONS_LABEL"
                    description="PLG_SYSTEM_CSVPROBE_HIDE_EXPORT_BUTTONS_DESC"
                    default="1"
                    class="btn-group"
                    showon="restrict_downloads:1">
                    <option value="1">JYES</option>
                    <option value="0">JNO</option>
                </field>

            </fieldset>
        </fields>
    </config>
</extension>